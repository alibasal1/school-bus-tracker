# Copy this file to .env and fill in real values. Never commit .env.
PORT=3003
# DynamoDB on Floci (on real AWS leave AWS_ENDPOINT_URL out). No database password is needed.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_PROFILE=floci
CORS_ORIGINS=http://localhost:5173
CALENDARIFIC_API_KEY=
# Requests per minute per client (middleware/rateLimit.js). deploy.sh puts it in the secret.
RATE_LIMIT_MAX=60
